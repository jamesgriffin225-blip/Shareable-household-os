# ---------------------------------------------------------------- required
# Postgres. Vercel Postgres and Supabase both give you a URL that works here;
# the schema creates itself on first request.
DATABASE_URL=postgres://user:password@host:5432/household

# The parsing layer: voice, photos and email all go through this.
ANTHROPIC_API_KEY=

# Signs OAuth state and the passcode cookie. Any long random string.
APP_SECRET=

# ---------------------------------------------------------------- household
# Names of the two profiles, comma separated. Only read the first time the
# database is seeded.
HOUSEHOLD_PROFILES=Alex,Partner

# Every spoken "Thursday at four" is resolved in this zone.
HOUSEHOLD_TIMEZONE=Australia/Brisbane

# One shared passcode for every device. Leave blank locally to disable the gate.
HOUSEHOLD_PASSCODE=

# Absolute origin, used to build OAuth redirect URIs and the links in OAuth
# callbacks. On Vercel this is detected automatically. Self-hosted, set it to
# the HTTPS URL the phones actually use, e.g. https://surface.tailnet.ts.net
APP_ORIGIN=

# ------------------------------------------------------------------- google
# One OAuth client, used by both people. Authorised redirect URI:
#   https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail is off by default, and that is what lets the calendar work properly.
# calendar.events is a "sensitive" scope: publish the app to production
# unverified, take one warning screen per person, and refresh tokens last.
# gmail.readonly is "restricted" — asking for it pins the app in testing mode,
# where refresh tokens expire every 7 days, unless you go through Google
# verification and a paid security assessment. Outlook covers email scanning
# without any of that. Set this to true only if you specifically want Gmail
# scanned and accept the weekly reconnect.
GOOGLE_ENABLE_GMAIL=false

# ---------------------------------------------------------------- microsoft
# Redirect URI: https://<your-domain>/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --------------------------------------------------------------- pocketsmith
POCKETSMITH_API_KEY=
# The accounts the money tile shows, in order, as `id=Label` pairs.
# By id, not by name: two accounts can share the first half of a title, and a
# name match picks one of them and looks right while being wrong. The tile
# lists every account with its id when this is empty, so you can read them off
# the dashboard rather than digging through Pocketsmith.
# e.g. POCKETSMITH_ACCOUNTS=5388380=Bills & Mortgage,5388405=Spending
POCKETSMITH_ACCOUNTS=

# ----------------------------------------------------------------- cameras
# Cameras come via Home Assistant, not from Blink directly: Blink has no public
# API, and its current client authenticates by scraping a sign-in page. Home
# Assistant already implements and maintains that, holds the Blink login on
# your own hardware, and gives us a documented REST API.
#
# Self-hosted on the same network as Home Assistant, this is just its LAN
# address (http://homeassistant.local:8123). Hosted somewhere else, it has to
# be an HTTPS URL that reaches home — a Tailscale Funnel or a Cloudflare Tunnel.
HOME_ASSISTANT_URL=
# Profile → Security → Long-lived access tokens, in Home Assistant.
HOME_ASSISTANT_TOKEN=
# Optional: only show these cameras, comma separated (e.g. camera.front_door).
HOME_ASSISTANT_CAMERAS=
# Optional: only these robots (e.g. vacuum.roborock,lawn_mower.mammotion).
# Left empty, every vacuum and mower Home Assistant can see shows up.
HOME_ASSISTANT_ROBOTS=

# ------------------------------------------------------------------ live view
# The Blink live-view proxy, which is a separate container and talks to Blink
# directly rather than through Home Assistant. Without it the cameras still
# show stills; with it each tile gets a Live button.
#   docker run -d --name blink-liveview-proxy --restart unless-stopped \
#     -p 8088:8088 -v blink-proxy-data:/data \
#     -e BLINK_USERNAME=... -e BLINK_PASSWORD=... \
#     ghcr.io/teethree89/ha-blink-live-view-proxy:latest
#   docker exec blink-liveview-proxy cat /data/proxy-token
BLINK_PROXY_URL=
BLINK_PROXY_TOKEN=
BLINK_PROXY_TIMEOUT_MS=15000

# --------------------------------------------------------------------- music
# Playlists for the Music tab, in order, as `Name=<link>` pairs. The link can
# be a share URL or a spotify: URI — whichever Spotify gave you.
# Whole tracks play for whoever is signed in to Spotify in that browser, so
# sign the wall in once; a signed-out browser gets 30-second previews.
# e.g. SPOTIFY_STATIONS=Kitchen=https://open.spotify.com/playlist/xxxx,Dinner=spotify:album:yyyy
# Only seeds an empty install — after that the list lives in Postgres and is
# edited from the Music tab, which is where it belongs.
SPOTIFY_STATIONS=

# Optional, and worth it: with these the Music tab can list the playlists you
# already have, so pinning one is a tap instead of copying a link.
# developer.spotify.com/dashboard — create an app, then add BOTH redirect URIs:
#   https://<your-tailnet-host>/api/auth/spotify/callback
#   http://127.0.0.1:3000/api/auth/spotify/callback
# Spotify rejects "localhost" outright; the loopback IP is the allowed form.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
HOME_ASSISTANT_TIMEOUT_MS=8000

# --------------------------------------------------------------------- cron
# The mailbox scan endpoint requires this as a bearer token, and refuses
# everything in production without it. Vercel Cron sends it automatically;
# self-hosted, a Task Scheduler job or cron entry sends it.
CRON_SECRET=
EMAIL_SCAN_LOOKBACK_HOURS=24
EMAIL_SCAN_LIMIT=25

# --------------------------------------------------------------- inference
# Two backends, same behaviour downstream.
#
#   api  Messages API with real tool definitions. Schema-enforced arguments,
#        typed errors, billed per token. Needs ANTHROPIC_API_KEY.
#   cli  Shells out to `claude -p` on a machine already signed in. No API key,
#        but no schema enforcement (JSON is asked for and parsed), a second or
#        two of process startup per call, and failures arrive as exit codes
#        rather than typed errors.
CLAUDE_BACKEND=api

# --- api backend
CLAUDE_MODEL=claude-opus-5
# Optional cheaper model for the high-volume paths (email scanning, aisle
# guessing). Most of the monthly cost is email, so this is the lever.
CLAUDE_EMAIL_MODEL=claude-haiku-4-5
CLAUDE_EFFORT=medium

# --- cli backend
# Where the Claude Code binary is. On Windows this is usually claude.cmd.
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=opus
# No CLAUDE_CLI_EMAIL_MODEL: it is not read. A cheaper model for the
# high-volume path is a cost lever, and cost per token is an API-backend idea
# -- this backend runs against a signed-in Claude Code, where the constraint
# is an allowance rather than a bill. It was set to haiku, which saved nothing
# and misread a dated invitation as chatter. Email defaults to sonnet here,
# and the household can change it in Settings, which is the only place a
# wall-mounted machine with no keyboard can be changed from.
CLAUDE_CLI_TIMEOUT_MS=120000
# Photos are written to a temp directory that becomes the CLI's working
# directory, and read from disk with this tool.
CLAUDE_CLI_ALLOWED_TOOLS=Read

# Optional: fallback speech-to-text for browsers without the Web Speech API.
# Any OpenAI-compatible /audio/transcriptions endpoint.
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=whisper-1
